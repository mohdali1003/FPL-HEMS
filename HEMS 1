// MAIN APP
// ═══════════════════════════════════════════════════════════════
export default function App() {
  const [screen, setScreen] = useState('splash');
  const [scenario, setScenario] = useState(null);
  const go = s => { setScreen(s); window.scrollTo?.(0,0); };
  const viewScenario = s => { setScenario(s); go('scenario'); };
  
  const screens = {
    splash: <Splash onNext={() => go('discovery')}/>,
    discovery: <Discovery onConnect={() => go('platforms')} onSkip={() => go('dashboard')}/>,
    platforms: <Platforms onNext={() => go('devices')} onBack={() => go('discovery')}/>,
    devices: <Devices onNext={() => go('dashboard')}/>,
    dashboard: <Dashboard onReport={() => go('report')} onScenario={viewScenario}/>,
    report: <Report onBack={() => go('dashboard')}/>,
    scenario: scenario ? <ScenarioDetail scenario={scenario} onBack={() => go('dashboard')}/> : null,
  };
  
  const order = ['splash','discovery','platforms','devices','dashboard','report','scenario'];
  
  return (
    <div className="w-full max-w-md mx-auto bg-white min-h-screen relative overflow-x-hidden" style={{ fontFamily:"-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif", boxShadow:'0 0 60px rgba(0,40,85,.15)' }}>
      {screens[screen]}
      <div className="fixed top-3 right-3 z-50 flex items-center gap-1 rounded-full px-2 py-1.5" style={{ background:'rgba(0,0,0,.25)', backdropFilter:'blur(8px)' }}>
        {order.filter(s => s!=='scenario'||scenario).map(s => (
          <button key={s} onClick={() => go(s)} className="rounded-full transition-all" style={{ width:screen===s?20:6, height:6, background:screen===s?C.sky:'rgba(255,255,255,.4)' }} title={s}/>
        ))}
      </div>
    </div>
  );
}
